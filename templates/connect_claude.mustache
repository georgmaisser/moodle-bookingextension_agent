{{!
    @template bookingextension_agent/connect_claude

    Readiness checklist and how-to for connecting an external AI client (Claude) over MCP + OAuth 2.1.

    Context variables required:
    * checks - array of {done, label, detail, icon, configureurl, configurelabel}
    * all_passed - bool, true when every check passed
    * server_url - string, the MCP endpoint URL to add in Claude

    Example context (json):
    {
        "checks": [
            {"done": true, "label": "MCP plugin installed", "detail": "OK", "icon": "<i></i>"}
        ],
        "all_passed": false,
        "server_url": "https://example.com/admin/tool/oauthmcp/server.php"
    }
}}
<div class="booking-ai-connect-claude" style="max-width: 820px;">
    <p class="lead">{{#str}}claudeconnect_intro, bookingextension_agent{{/str}}</p>
    <p class="text-muted">{{#str}}claudeconnect_intro_detail, bookingextension_agent{{/str}}</p>

    <h4 class="mt-4">{{#str}}claudeconnect_prerequisites, bookingextension_agent{{/str}}</h4>
    <ul class="list-group mt-2 mb-0">
        {{#checks}}
        <li class="list-group-item d-flex align-items-start">
            <span class="mr-3 mt-1">{{{icon}}}</span>
            <div>
                <strong>{{label}}</strong>
                <div class="small text-muted mt-1">{{detail}}</div>
                {{#configureurl}}
                <div class="small mt-1"><a href="{{configureurl}}">{{configurelabel}}</a></div>
                {{/configureurl}}
            </div>
        </li>
        {{/checks}}
    </ul>

    {{#all_passed}}
    <div class="alert alert-success mt-4" role="status">
        <h5 class="alert-heading"><i class="fa fa-check-circle mr-1" aria-hidden="true"></i>{{#str}}claudeconnect_ready_heading, bookingextension_agent{{/str}}</h5>
        <p class="mb-0">{{#str}}claudeconnect_ready_body, bookingextension_agent{{/str}}</p>
    </div>
    {{/all_passed}}
    {{^all_passed}}
    <div class="alert alert-warning mt-4" role="status">
        <h5 class="alert-heading"><i class="fa fa-exclamation-triangle mr-1" aria-hidden="true"></i>{{#str}}claudeconnect_notready_heading, bookingextension_agent{{/str}}</h5>
        <p class="mb-0">{{#str}}claudeconnect_notready_body, bookingextension_agent{{/str}}</p>
    </div>
    {{/all_passed}}

    <h4 class="mt-4">{{#str}}claudeconnect_howto_heading, bookingextension_agent{{/str}}</h4>
    <p>{{#str}}claudeconnect_howto_intro, bookingextension_agent{{/str}}</p>

    <div class="form-group">
        <label class="font-weight-bold small mb-1" for="booking-ai-mcp-url">{{#str}}claudeconnect_server_url_label, bookingextension_agent{{/str}}</label>
        <input type="text" id="booking-ai-mcp-url" class="form-control" readonly value="{{server_url}}" aria-label="{{#str}}claudeconnect_server_url_label, bookingextension_agent{{/str}}">
    </div>

    <ol class="mt-3">
        <li class="mb-2">{{#str}}claudeconnect_step_open, bookingextension_agent{{/str}}</li>
        <li class="mb-2">{{#str}}claudeconnect_step_add, bookingextension_agent{{/str}}</li>
        <li class="mb-2">{{#str}}claudeconnect_step_paste, bookingextension_agent{{/str}}</li>
        <li class="mb-2">{{#str}}claudeconnect_step_authenticate, bookingextension_agent{{/str}}</li>
        <li class="mb-2">{{#str}}claudeconnect_step_consent, bookingextension_agent{{/str}}</li>
        <li class="mb-2">{{#str}}claudeconnect_step_done, bookingextension_agent{{/str}}</li>
    </ol>

    <div class="alert alert-info mt-3" role="note">
        {{#str}}claudeconnect_howto_note, bookingextension_agent{{/str}}
    </div>
</div>
